local function resetStatus()
    task.wait(1.5)

    if screenGui.Parent and not isHidden then
        statusLabel.Text = "🚀 Pilih Script yang Mau Di Load"
        statusLabel.TextColor3 = Color3.fromRGB(180, 160, 210)
    end
end

local function showLauncher()
    isHidden = false
    hideIcon.Visible = false
    mainFrame.Visible = true

    mainFrame.BackgroundTransparency = 1
    border.Transparency = 1

    TweenService:Create(
        mainFrame,
        TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {BackgroundTransparency = 0}
    ):Play()

    TweenService:Create(
        border,
        TweenInfo.new(0.3),
        {Transparency = 0.2}
    ):Play()
end

local function hideLauncher()
    isHidden = true

    local fade = TweenService:Create(
        mainFrame,
        TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        {BackgroundTransparency = 1}
    )

    TweenService:Create(
        border,
        TweenInfo.new(0.25),
        {Transparency = 1}
    ):Play()

    fade:Play()

    fade.Completed:Connect(function()
        if isHidden and screenGui.Parent then
            mainFrame.Visible = false
            hideIcon.Visible = true

            hideIcon.Size = UDim2.new(0, 0, 0, 0)

            TweenService:Create(
                hideIcon,
                TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {Size = UDim2.new(0, 50, 0, 50)}
            ):Play()
        end
    end)
end

