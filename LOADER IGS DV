task.spawn(function()
    local stages = {
        {15, "Initializing launcher..."},
        {35, "Loading interface..."},
        {55, "Preparing farming system..."},
        {75, "Preparing buy system..."},
        {90, "Finalizing..."},
        {100, "Ready!"}
    }
    local previous = 0
    for _, stage in ipairs(stages) do
        local percent = stage[1]
        local text = stage[2]
        loadingSub.Text = text
        TweenService:Create(
            progress,
            TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Size = UDim2.new(percent / 100, 0, 1, 0)}
        ):Play()
        for i = previous, percent do
            percentLabel.Text = i .. "%"
            task.wait(0.006)
        end
        previous = percent
        task.wait(0.1)
    end
    task.wait(0.3)
    loadingBorderWrapper:Destroy()
    mainBorderWrapper.Visible = true
end)
