task.spawn(function()
    local stages = {
        {15, "Initializing launcher..."},
        {35, "Loading interface..."},
        {55, "Preparing farming system..."},
        {75, "Preparing buy system..."},
        {90, "Finalizing..."},
        {100, "Ready!"}
    }

    local previous = 0

    for _, stage in ipairs(stages) do
        local percent = stage[1]
        local text = stage[2]

        loadingSub.Text = text

        TweenService:Create(
            progress,
            TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {
                Size = UDim2.new(percent / 100, 0, 1, 0)
            }
        ):Play()

        for i = previous, percent do
            percentLabel.Text = i .. "%"
            task.wait(0.008)
        end

        previous = percent
        task.wait(0.1)
    end

    task.wait(0.4)

    for _, obj in ipairs(loadingFrame:GetDescendants()) do
        if obj:IsA("TextLabel") then
            TweenService:Create(
                obj,
                TweenInfo.new(0.35),
                {TextTransparency = 1}
            ):Play()
        elseif obj:IsA("Frame") then
            TweenService:Create(
                obj,
                TweenInfo.new(0.35),
                {BackgroundTransparency = 1}
            ):Play()
        elseif obj:IsA("UIStroke") then
            TweenService:Create(
                obj,
                TweenInfo.new(0.35),
                {Transparency = 1}
            ):Play()
        end
    end

    task.wait(0.4)

    loadingFrame:Destroy()
    mainFrame.Visible = true
    mainFrame.BackgroundTransparency = 1
    border.Transparency = 1

    TweenService:Create(
        mainFrame,
        TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {BackgroundTransparency = 0}
    ):Play()

    TweenService:Create(
        border,
        TweenInfo.new(0.45),
        {Transparency = 0.2}
    ):Play()
end)

