local function getJobBasePart()
    local success, result = pcall(function()
        return Workspace.Ekonomi.BedilPusat.Job
    end)
    if success and result then
        return result
    end
    return nil
end

local function brutalTeleport(targetPos)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local distance = (hrp.Position - targetPos).Magnitude
        
        if distance < 100 then
            hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
            return
        end
        
        if settings.UseVelocity then
            hrp.Velocity = Vector3.new(0, 0, 0)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            
            local midPoint = (hrp.Position + targetPos) / 2
            midPoint = midPoint + Vector3.new(0, 50, 0)
            hrp.CFrame = CFrame.new(midPoint)
            
            local direction = (targetPos - midPoint).Unit
            hrp.Velocity = direction * 200
            hrp.AssemblyLinearVelocity = direction * 200
            
            RunService.Heartbeat:Wait()
        end
        
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
        hrp.Velocity = Vector3.new(0, 0, 0)
        
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Landed)
        end
    end)
end

local function burstTeleport(targetPos)
    if not settings.UseBurstMode then
        brutalTeleport(targetPos)
        return
    end
    
    for i = 1, settings.BurstCount do
        if not autoDeliveryActive then break end
        local offset = Vector3.new(
            math.random(-5, 5),
            math.random(0, 10),
            math.random(-5, 5)
        )
        brutalTeleport(targetPos + offset)
        task.wait(settings.BurstSpeed)
    end
    brutalTeleport(targetPos)
end

local function getHumanizedDelay()
    return math.random(settings.HumanizedMin * 100, settings.HumanizedMax * 100) / 100
end

local function teleportToPosition(pos)
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        local seat = character:FindFirstChildOfClass("Humanoid") and character.Humanoid.SeatPart
        
        local targetObject = nil
        if seat and seat.Parent then
            targetObject = seat.Parent:FindFirstChild("PrimaryPart") or seat.Parent
        elseif humanoidRootPart then
            targetObject = humanoidRootPart
        end

        if targetObject then
            if targetObject:IsA("Model") and targetObject.PrimaryPart then
                targetObject:SetPrimaryPartCFrame(CFrame.new(pos + Vector3.new(0, 3, 0)))
            elseif targetObject:IsA("BasePart") then
                targetObject.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
            end
        end
    end)
end

