deliveryRemote.OnClientEvent:Connect(function(param1, param2)
    if typeof(param1) == "string" then
        currentJobStatus = param1
        if param1 == "JOB_FINISHED" or param1 == "JOB_ENDED" then
            currentTargetPosition = nil
        end
    elseif typeof(param1) == "Vector3" then
        currentTargetPosition = param1
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if autoDeliveryActive then
            pcall(function()
                local character = LocalPlayer.Character
                if not character then return end
                
                local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
                local seat = character:FindFirstChildOfClass("Humanoid") and character.Humanoid.SeatPart
                
                local targetObject = nil
                if seat and seat.Parent then
                    targetObject = seat.Parent:FindFirstChild("PrimaryPart") or seat.Parent
                elseif humanoidRootPart then
                    targetObject = humanoidRootPart
                end

                if targetObject then
                    tpCounter = tpCounter + 1
                    
                    if tpCounter >= 3 then
                        if statusText then 
                            statusText.Text = "⏳ Cooldown 3s..."
                            statusText.TextColor3 = Color3.fromRGB(255, 200, 100)
                        end
                        
                        for i = 1, 30 do
                            if not autoDeliveryActive then break end
                            task.wait(0.1)
                        end
                        
                        tpCounter = 0  
                        if autoDeliveryActive and statusText then 
                            statusText.Text = "🔥 Delivery Active!"
                            statusText.TextColor3 = Color3.fromRGB(100, 255, 100)
                        end
                    end

                    if not autoDeliveryActive then return end

                    if currentTargetPosition then
                        if targetObject:IsA("Model") and targetObject.PrimaryPart then
                            targetObject:SetPrimaryPartCFrame(CFrame.new(currentTargetPosition + Vector3.new(0, 3, 0)))
                        elseif targetObject:IsA("BasePart") then
                            targetObject.CFrame = CFrame.new(currentTargetPosition + Vector3.new(0, 3, 0))
                        end
                    else
                        local jobBase = getJobBasePart()
                        if jobBase then
                            local baseCFrame = jobBase:IsA("BasePart") and jobBase.CFrame or (jobBase:IsA("Model") and jobBase.PrimaryPart and jobBase.PrimaryPart.CFrame)
                            if baseCFrame then
                                if targetObject:IsA("Model") and targetObject.PrimaryPart then
                                    targetObject:SetPrimaryPartCFrame(baseCFrame + Vector3.new(0, 3, 0))
                                elseif targetObject:IsA("BasePart") then
                                    targetObject.CFrame = baseCFrame + Vector3.new(0, 3, 0)
                                end
                            end
                        end
                        
                        if statusText and not statusText.Text:find("Cooldown") then
                            statusText.Text = "📍 Menuju Pangkalan Job..."
                            statusText.TextColor3 = Color3.fromRGB(200, 160, 255)
                        end
                    end
                end
            end)
        end
    end
end)

