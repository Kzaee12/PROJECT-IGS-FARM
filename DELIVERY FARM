deliveryRemote.OnClientEvent:Connect(function(param1, param2)
    if typeof(param1) == "string" then
        currentJobStatus = param1
        if param1 == "JOB_FINISHED" or param1 == "JOB_ENDED" then
            currentTargetPosition = nil
        end
    elseif typeof(param1) == "Vector3" then
        currentTargetPosition = param1
    end
end)

task.spawn(function()
    local frameSkip = 0
    
    while task.wait(settings.TeleportDelay) do
        if not autoDeliveryActive then 
            task.wait(0.5)
            continue 
        end
        
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            if settings.AntiAFK then
                frameSkip = frameSkip + 1
                if frameSkip % 10 == 0 then
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton2(Vector2.new())
                    end)
                end
            end
            
            local targetPos = nil
            if currentTargetPosition then
                targetPos = currentTargetPosition
            else
                local jobBase = getJobBasePart()
                if jobBase then
                    local baseCFrame = jobBase:IsA("BasePart") and jobBase.CFrame or 
                                      (jobBase:IsA("Model") and jobBase.PrimaryPart and jobBase.PrimaryPart.CFrame)
                    if baseCFrame then
                        targetPos = baseCFrame.Position
                    end
                end
            end
            
            if targetPos then
                local distance = (hrp.Position - targetPos).Magnitude
                
                if statusText then
                    statusText.Text = string.format("🚀 Teleporting... (%d studs)", math.floor(distance))
                    statusText.TextColor3 = Color3.fromRGB(255, 200, 100)
                end
                
                if distance > 1000 then
                    burstTeleport(targetPos)
                elseif distance > 100 then
                    brutalTeleport(targetPos)
                else
                    hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                end
                
                local humanDelay = getHumanizedDelay()
                task.wait(humanDelay)
                
                if statusText then
                    statusText.Text = "✅ Delivery Active!"
                    statusText.TextColor3 = Color3.fromRGB(100, 255, 100)
                end
                
                tpCounter = tpCounter + 1
            end
        end)
    end
end)

if settings.AutoReconnect then
    LocalPlayer.OnTeleport:Connect(function()
        task.wait(1)
        autoDeliveryActive = true
    end)

    game:GetService("CoreGui").ChildRemoved:Connect(function(child)
        if child.Name == "DVExploitsDelivery" then
            task.wait(0.5)
            createDVUI()
            autoDeliveryActive = true
        end
    end)
end
