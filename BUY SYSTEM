local function GetItemIcon(itemName)
	if ItemIcons[itemName] then
		return ItemIcons[itemName]
	end

	local itemData = ItemConfig.Get(itemName)

	if itemData then
		local category = itemData.Category
		if category == "Subwoffer" then return "🔊" end
		if category == "Middle" then return "🎵" end
		if category == "Lighting" then return "💡" end
		if category == "Audio" then return "🎛️" end
		if category == "Rig" then return "🔧" end
		if category == "Kendaraan" then return "🚗" end
	end

	return "📦"
end

