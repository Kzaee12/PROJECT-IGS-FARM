			TweenInfo.new(0.5),
			{
				TextTransparency=1,
				BackgroundTransparency=1
			}
		):Play()

		task.wait(0.5)

		if Notif then
			Notif:Destroy()
		end
	end)
end

local function RenderItems(searchQuery)
	for _,child in ipairs(ScrollingFrame:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	searchQuery = string.lower(searchQuery or "")

	for _,item in ipairs(AllLoadedItems) do
		local itemName = item.itemName
		local displayName = item.displayName
		local price = item.price
		local stock = item.stock
		local icon = item.icon

		if searchQuery == ""
			or string.find(string.lower(displayName),searchQuery)
			or string.find(string.lower(itemName),searchQuery) then

			local tierLevel = ItemConfig.GetTier(itemName)
			local tierData = ItemConfig.GetTierConfig(tierLevel)
			local tierName = tierData.Name
			local tierColor = tierData.Color

			local Row = Instance.new("Frame")
			Row.Size = UDim2.new(1,-8,0,42)
			Row.BackgroundColor3 = Color3.fromRGB(22,16,32)
			Row.Parent = ScrollingFrame

			Instance.new("UICorner",Row).CornerRadius = UDim.new(0,5)

			local RowStroke = Instance.new("UIStroke")
			RowStroke.Color = tierColor
			RowStroke.Thickness = 0
			RowStroke.Transparency = 1
			RowStroke.Parent = Row

			Row.MouseEnter:Connect(function()
				TweenService:Create(
					RowStroke,
					TweenInfo.new(0.2),
					{
						Thickness=1.5,
						Transparency=0.5
					}
				):Play()
			end)

			Row.MouseLeave:Connect(function()
				TweenService:Create(
					RowStroke,
					TweenInfo.new(0.2),
					{
						Thickness=0,
						Transparency=1
					}
				):Play()
			end)

			local IconHolder = Instance.new("Frame")
			IconHolder.Size = UDim2.new(0,32,0,32)
			IconHolder.Position = UDim2.new(0,4,0.5,-16)
			IconHolder.BackgroundColor3 = Color3.fromRGB(12,8,18)
			IconHolder.Parent = Row

			Instance.new("UICorner",IconHolder).CornerRadius = UDim.new(0,5)

			local IconStroke = Instance.new("UIStroke")
			IconStroke.Color = tierColor
			IconStroke.Thickness = 1.2
			IconStroke.Parent = IconHolder

			local ItemIcon = Instance.new("TextLabel")
			ItemIcon.Size = UDim2.new(1,0,1,0)
			ItemIcon.BackgroundTransparency = 1
			ItemIcon.TextColor3 = tierColor
			ItemIcon.TextSize = 16
			ItemIcon.Font = Enum.Font.Code
			ItemIcon.Text = icon or "📦"
			ItemIcon.TextXAlignment = Enum.TextXAlignment.Center
			ItemIcon.TextYAlignment = Enum.TextYAlignment.Center
			ItemIcon.Parent = IconHolder

			local CheckBox = Instance.new("TextButton")
			CheckBox.Size = UDim2.new(0,19,0,19)
			CheckBox.Position = UDim2.new(0,41,0.5,-9)
			CheckBox.BackgroundColor3 =
				SelectedItems[itemName]
				and SelectedItems[itemName].Selected
				and Color3.fromRGB(160,32,240)
				or Color3.fromRGB(35,25,48)
			CheckBox.TextColor3 = Color3.fromRGB(255,255,255)
			CheckBox.Text =
				SelectedItems[itemName]
				and SelectedItems[itemName].Selected
				and "✓"
				or ""
			CheckBox.TextSize = 10
			CheckBox.Font = Enum.Font.Code
			CheckBox.Parent = Row

			Instance.new("UICorner",CheckBox).CornerRadius = UDim.new(0,4)

			local InfoLabel = Instance.new("TextLabel")
			InfoLabel.Size = UDim2.new(1,-135,1,0)
			InfoLabel.Position = UDim2.new(0,67,0,0)
			InfoLabel.BackgroundTransparency = 1
			InfoLabel.TextXAlignment = Enum.TextXAlignment.Left
			InfoLabel.TextYAlignment = Enum.TextYAlignment.Center
			InfoLabel.TextColor3 = Color3.fromRGB(230,230,230)
			InfoLabel.TextSize = 8
			InfoLabel.Font = Enum.Font.Code

			InfoLabel.Text = string.format(
				"%s [%s]\nRp%s | Stok: %s",
				tostring(displayName),
				tierName,
				formatRupiah(price),
				tostring(stock)
			)

			InfoLabel.Parent = Row

			local QtyBox = Instance.new("TextBox")
			QtyBox.Size = UDim2.new(0,52,0,22)
			QtyBox.Position = UDim2.new(1,-58,0.5,-11)
			QtyBox.BackgroundColor3 = Color3.fromRGB(25,18,38)
			QtyBox.TextColor3 = Color3.fromRGB(200,100,255)
			QtyBox.PlaceholderText = "Qty"
			QtyBox.Text =
				SelectedItems[itemName]
				and SelectedItems[itemName].QtyBox.Text
				or "1"
			QtyBox.TextSize = 9
			QtyBox.Font = Enum.Font.Code
			QtyBox.Parent = Row

			Instance.new("UICorner",QtyBox).CornerRadius = UDim.new(0,4)

			if not SelectedItems[itemName] then
				SelectedItems[itemName] = {
					Selected=false,
					QtyBox=QtyBox,
					Stock=stock,
					BasePrice=price
				}
			else
				SelectedItems[itemName].QtyBox = QtyBox
			end

			CheckBox.MouseButton1Click:Connect(function()
				local ref = SelectedItems[itemName]
				ref.Selected = not ref.Selected

				CheckBox.BackgroundColor3 =
					ref.Selected
					and Color3.fromRGB(160,32,240)
					or Color3.fromRGB(35,25,48)

				CheckBox.Text = ref.Selected and "✓" or ""
			end)

			QtyBox:GetPropertyChangedSignal("Text"):Connect(function()
				local qty = tonumber(QtyBox.Text) or 1

				if qty < 1 then
					qty = 1
				end

				local totalCost = price * qty

				InfoLabel.Text = string.format(
					"%s [%s]\nRp%s | %dx | Stok: %s",
					tostring(displayName),
					tierName,
					formatRupiah(totalCost),
					qty,
					tostring(stock)
				)
			end)
		end
	end

	local totalHeight = 0

	for _,child in ipairs(ScrollingFrame:GetChildren()) do
		if child:IsA("Frame") then
			totalHeight += child.AbsoluteSize.Y + 4
		end
	end

	ScrollingFrame.CanvasSize = UDim2.new(0,0,0,totalHeight)
end

local function LoadShop(tokoName)
	currentTokoName = tokoName

	local logo = ShopLogos[tokoName] or "🏪"
	DropdownBtn.Text = logo.." "..tokoName.." ▾"

	SelectedItems = {}
	AllLoadedItems = {}

	local success,serverItems = pcall(function()
		return GetShopItems:InvokeServer(tokoName,"Semua")
	end)

	if not success or not serverItems or type(serverItems) ~= "table" then
		ShowNotif("Gagal menarik data dari toko "..tokoName,true)
		return
	end

	for _,itemData in pairs(serverItems) do
		local itemName =
			itemData.Name
			or itemData[1]
			or "Unknown"

		local price =
			tonumber(
				itemData.Price
				or itemData.Harga
			)
			or 0

		local stock =
			tonumber(
				itemData.Stock
				or itemData.Stok
				or itemData.Quantity
			)
			or 999

		local displayName =
			itemData.DisplayName
			or itemData.Nama
			or itemName

		table.insert(AllLoadedItems,{
			itemName=itemName,
			displayName=displayName,
			price=price,
			stock=stock,
			icon=GetItemIcon(itemName)
		})
	end

	RenderItems(SearchBox.Text)
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
	RenderItems(SearchBox.Text)
end)

