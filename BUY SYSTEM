local function SetupDropdown(tokoList)
	for _,child in ipairs(DropdownList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _,tokoName in ipairs(tokoList) do
		local TokoBtn = Instance.new("TextButton")

		TokoBtn.Size = UDim2.new(1,0,0,24)
		TokoBtn.BackgroundColor3 = Color3.fromRGB(22,16,32)
		TokoBtn.TextColor3 = Color3.fromRGB(200,150,255)

		local logo = ShopLogos[tokoName] or "🏪"

		TokoBtn.Text = " "..logo.." "..tostring(tokoName)
		TokoBtn.TextSize = 9
		TokoBtn.Font = Enum.Font.Code
		TokoBtn.TextXAlignment = Enum.TextXAlignment.Left
		TokoBtn.ZIndex = 11
		TokoBtn.Parent = DropdownList

		TokoBtn.MouseButton1Click:Connect(function()
			isDropdownOpen = false
			DropdownList.Visible = false
			DropdownList.Size = UDim2.new(1,-20,0,0)

			LoadShop(tokoName)
			ShowNotif(" Change Toko: "..tokoName)
		end)
	end
end

DropdownBtn.MouseButton1Click:Connect(function()
