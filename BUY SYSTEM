		local totalH = 0

		for _,c in ipairs(DropdownList:GetChildren()) do
			if c:IsA("TextButton") then
				totalH += 24
			end
		end

		DropdownList.CanvasSize = UDim2.new(0,0,0,totalH)
	end
end)

BuySelectedBtn.MouseButton1Click:Connect(function()
	local count = 0
	local totalItems = 0

	for itemName,data in pairs(SelectedItems) do
		if data.Selected then
			count += 1

			local qty = tonumber(data.QtyBox.Text) or 1

			if qty < 1 then
				qty = 1
			end

			totalItems += qty

			task.spawn(function()
				local success,msg = pcall(function()
					return PurchaseEvent:InvokeServer(itemName,qty)
				end)

				if success then
					if msg == false
						or (
							type(msg) == "string"
							and (
								msg:lower():find("gagal")
								or msg:lower():find("cukup")
							)
						) then

						ShowNotif(
							"Gagal beli "..itemName.." (Saldo/Stok)",
							true
						)
					else
						ShowNotif(
							string.format(
								"Sukses Membeli %dx %s",
								qty,
								itemName
							)
						)
					end
				else
					ShowNotif(
						"Gagal transaksi item "..itemName,
						true
					)
				end
			end)

			task.wait(0.1)
		end
	end

	if count == 0 then
		ShowNotif("Pilih minimal 1 item lewat checkbox!",true)
	else
		ShowNotif(
			string.format(
				"Memproses %d item (%d unit)...",
				count,
				totalItems
			)
		)
	end
end)

