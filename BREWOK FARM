        task.spawn(function()
            while farmingActive do
                pcall(function()
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local activeFolder = game.Workspace:FindFirstChild("Ekonomi") and game.Workspace.Ekonomi:FindFirstChild("ActiveJobs")
                        local jobFolder = game.Workspace:FindFirstChild("Ekonomi") and game.Workspace.Ekonomi:FindFirstChild("Job")
                        local targets = {}
                        
                        if jobFolder and jobFolder:FindFirstChild("Brewog") then 
                            table.insert(targets, jobFolder.Brewog) 
                        end
                        
                        if activeFolder then
                            for _, f in ipairs(activeFolder:GetChildren()) do
                                if f.Name:match("^Brewog") then
                                    if f:FindFirstChild("TempatAmbil") then 
                                        table.insert(targets, f.TempatAmbil) 
                                    end
                                    if f:FindFirstChild("TempatTaruh1") then 
                                        table.insert(targets, f.TempatTaruh1) 
                                    end
                                    if f:FindFirstChild("TempatTaruh2") then 
                                        table.insert(targets, f.TempatTaruh2) 
                                    end
                                end
                            end
                        end
                        
                        for _, p in ipairs(targets) do 
                            if p:IsA("BasePart") then 
                                p.CanCollide = false
                                p.Anchored = false
                                p.CFrame = hrp.CFrame
                            end
                        end
                    end
                end)
                RunService.Heartbeat:Wait()
            end
        end)
    end
end)

