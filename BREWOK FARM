local function updateLight()
    if not lightOn then return end
    Lighting.ClockTime = tonumber(ClockBox.Text) or 14
    Lighting.Brightness = tonumber(BrightBox.Text) or 3
    Lighting.GlobalShadows = not shadowOff
    Lighting.OutdoorAmbient = Color3.fromRGB(220, 220, 220)
end

LToggle.MouseButton1Click:Connect(function()
    lightOn = not lightOn
    if lightOn then
        LToggle.BackgroundColor3 = Color3.fromRGB(40, 160, 60)
        LToggle.Text = "⚡ Status Lighting: ON"
        updateLight()
    else
        LToggle.BackgroundColor3 = Color3.fromRGB(140, 20, 30)
        LToggle.Text = "⚡ Status Lighting: OFF"
        Lighting.GlobalShadows = true
        Lighting.Brightness = 1
        Lighting.ClockTime = 14
    end
end)

SBtn.MouseButton1Click:Connect(function()
    shadowOff = not shadowOff
    SBtn.Text = shadowOff and "🌑 Global Shadows: OFF" or "🌑 Global Shadows: ON"
    if lightOn then updateLight() end
end)

ClockBox:GetPropertyChangedSignal("Text"):Connect(updateLight)
