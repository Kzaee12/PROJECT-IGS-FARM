local function applyBodyState(rootPart, humanoid)
    if not rootPart then return end
    if _G_BodyState == "KepalaBawah" then
        if humanoid then humanoid.PlatformStand = true end
        rootPart.Anchored = false
        rootPart.CFrame = rootPart.CFrame * CFrame.Angles(math.rad(180), 0, 0)
    elseif _G_BodyState == "Terlentang" then
        if humanoid then humanoid.PlatformStand = true end
        rootPart.Anchored = false
        rootPart.CFrame = rootPart.CFrame * CFrame.Angles(math.rad(90), 0, 0)
    else
        if humanoid and not _G_AutoFlyActive then humanoid.PlatformStand = false end
        rootPart.Anchored = false
    end
end

local function toggleFly(state)
    if not _G_AutoFlyEnabled then
        if flyConnection then flyConnection:Disconnect() end
        if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and _G_BodyState == "Berdiri" then hum.PlatformStand = false end
        return
    end

    _G_AutoFlyActive = state
    local char = LocalPlayer.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    if state then
        if humanoid then humanoid.PlatformStand = true end
        if not rootPart then return end
        
        if not bodyVelocity then
            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.Parent = rootPart
        end
        
        if not bodyGyro then
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bodyGyro.CFrame = rootPart.CFrame
            bodyGyro.Parent = rootPart
        end
        
        if flyConnection then flyConnection:Disconnect() end
        flyConnection = RunService.RenderStepped:Connect(function()
            if not _G_AutoFlyActive or not char or not rootPart then return end
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyGyro.CFrame = Workspace.CurrentCamera.CFrame
        end)
    else
        if humanoid and _G_BodyState == "Berdiri" then humanoid.PlatformStand = false end
        if flyConnection then flyConnection:Disconnect() end
        if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    end
end

local function burstInstantTeleport(targetCFrame)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not rootPart then return end
        
        task.spawn(function()
            for i = 1, _G_BurstCount do
                if rootPart and _G_AutoFarmActive then
                    rootPart.CFrame = targetCFrame
                    applyBodyState(rootPart, humanoid)
                    task.wait(0.01)
                else
                    break
                end
            end
        end)
    end)
end

local function manualTeleport(targetCFrame)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not rootPart then return end
        if humanoid then humanoid.PlatformStand = false end
        rootPart.Anchored = false
        rootPart.CFrame = targetCFrame
    end)
end

local remoteEventConnection = nil
local function hookGameRemotes()
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local jobRemotes = remotes and remotes:FindFirstChild("Job")
        local brewogUIEvent = jobRemotes and jobRemotes:FindFirstChild("BrewogUI")
        
        if brewogUIEvent and brewogUIEvent:IsA("RemoteEvent") then
            if remoteEventConnection then remoteEventConnection:Disconnect() end
            remoteEventConnection = brewogUIEvent.OnClientEvent:Connect(function(actionType, value)
                if actionType == "Stage2" or actionType == "Progress2" or (actionType == "Progress" and value and type(value) == "number" and value >= 5) then
                    _G_CurrentStage = "Stage2"
                    if ProgressDisplay then ProgressDisplay.Text = "Status: Tempat Taruh 2" ProgressDisplay.TextColor3 = Color3.fromRGB(255, 120, 120) end
                elseif actionType == "Progress1" then
                    _G_CurrentProgressCount = value or 0
                    if _G_CurrentProgressCount >= 5 then
                        _G_CurrentStage = "Stage2"
                        if ProgressDisplay then ProgressDisplay.Text = "Progres 1 Selesai -> Taruh 2" ProgressDisplay.TextColor3 = Color3.fromRGB(255, 120, 120) end
                    else
                        _G_CurrentStage = "Progress1"
                        if ProgressDisplay then ProgressDisplay.Text = "Progres 1: " .. _G_CurrentProgressCount .. " / 5" ProgressDisplay.TextColor3 = Color3.fromRGB(255, 160, 160) end
                    end
                end
            end)
        end
    end)
end
hookGameRemotes()

